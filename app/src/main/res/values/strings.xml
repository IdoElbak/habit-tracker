    <string name="settings_battery_title">Keep reminders working</string>
    <string name="settings_battery_body">Samsung puts unused apps to sleep, which silently kills reminders. Exempt this app from battery optimisation, then check Settings → Battery → Background usage limits and remove Tracker from Sleeping apps.</string>
